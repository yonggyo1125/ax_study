   "source": [
    "# 반복 순회 실행 - RunnableEach\n",
    "\n",
    "from langchain_core.runnables.base import RunnableEach\n",
    "from langchain_core.runnables import RunnableLambda\n",
    "\n",
    "func_a = RunnableLambda(lambda x: f\"**{x}**\")\n",
    "\n",
    "chain = RunnableEach(bound=func_a)\n",
    "\n",
    "fruits = [\"사과\", \"오렌지\", \"망고\"]\n",
    "\n",
    "chain.invoke(fruits)"
   ]
